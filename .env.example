APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://zhicluster:local_password@db:5432/zhicluster
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_BATCH_MB=200
MAX_UPLOAD_BATCH_FILES=20
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_SUPPORTS_TOOLS=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
MAX_INGESTION_ATTEMPTS=3
# Shared by model gateways within one process; API and worker have separate limits.
# At >=2, background work leaves one slot available for interactive calls.
MAX_CONCURRENT_MODEL_CALLS=3
SUMMARY_INPUT_TOKENS=6000
SUMMARY_MAX_CALLS=80
JOB_LEASE_SECONDS=180
# Startup-only worker lanes. Restart worker after changing these values.
# Independent documents: 1-16; chat/agent tasks: 1-8.
WORKER_INGESTION_CONCURRENCY=3
WORKER_INTERACTIVE_CONCURRENCY=1
# Web settings secrets are encrypted with the key stored in this private directory.
# Compose overrides this to /app/runtime and persists it in its runtime volume.
RUNTIME_CONFIG_DIR=../.data/runtime
